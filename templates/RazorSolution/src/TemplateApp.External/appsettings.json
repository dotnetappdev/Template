{
  "Api": {
    "BaseUrl": "https://api.example.com/",
//#if (UseApiKey)
    "ApiKey": "__API_KEY__",
//#endif
    "TimeoutSeconds": 30
  },
//#if (UseSentry)
  "Sentry": {
    "Dsn": "__ERROR_MONITORING_KEY__",
    "SendDefaultPii": false,
    "MinimumEventLevel": "Error",
    "TracesSampleRate": 0.2
  },
//#elseif (UseRaygun)
  "RaygunSettings": {
    "ApiKey": "__ERROR_MONITORING_KEY__"
  },
//#elseif (UseAppInsights)
  "ApplicationInsights": {
    "ConnectionString": "__ERROR_MONITORING_KEY__"
  },
//#endif
//#if (UseSharedSignIn)
  "Authentication": {
    "SharedKeysFolder": "",
    "CookieDomain": ""
  },
//#endif
//#if (IncludeSerilog)
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/TemplateApp.External-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

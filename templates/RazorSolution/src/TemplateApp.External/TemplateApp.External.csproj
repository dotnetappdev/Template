<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Independent front-end site. It has no reference to Services, SqlRepository or EF Core:
    every piece of data comes from TemplateApp.API through the typed clients in /ApiClients.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TemplateApp.External</RootNamespace>
    <UserSecretsId>7A0D5E21-0C3B-4F55-8D2E-6B1F9C4A2E03</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restores the client libraries in libman.json into wwwroot/lib on build. -->
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" />
<!--#if (IncludeResilience) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
<!--#endif -->
<!--#if (IncludeSerilog) -->
    <PackageReference Include="Serilog.AspNetCore" />
<!--#endif -->
<!--#if (UseSentry) -->
    <PackageReference Include="Sentry.AspNetCore" />
<!--#elseif (UseRaygun) -->
    <PackageReference Include="Mindscape.Raygun4Net.AspNetCore" />
<!--#elseif (UseAppInsights) -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
<!--#endif -->
  </ItemGroup>

</Project>

{
//#if (UseSqlRepository)
  "ConnectionStrings": {
//#if (HasCustomConnectionString)
    "DefaultConnection": "__CUSTOM_CONNECTION_STRING__"
//#elseif (UseSqlite)
    "DefaultConnection": "Data Source=__DB_NAME__.db"
//#elseif (UsePostgreSql)
    "DefaultConnection": "Host=__DB_SERVER__;Port=5432;Database=__DB_NAME__;Username=__DB_USER__;Password=__DB_PASSWORD__"
//#elseif (UseAzureSql && UseIntegratedAuth)
    "DefaultConnection": "Server=tcp:__DB_SERVER__,1433;Database=__DB_NAME__;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"
//#elseif (UseAzureSql)
    "DefaultConnection": "Server=tcp:__DB_SERVER__,1433;Database=__DB_NAME__;User ID=__DB_USER__;Password=__DB_PASSWORD__;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"
//#elseif (UseIntegratedAuth)
    "DefaultConnection": "Server=__DB_SERVER__;Database=__DB_NAME__;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
//#else
    "DefaultConnection": "Server=__DB_SERVER__;Database=__DB_NAME__;User Id=__DB_USER__;Password=__DB_PASSWORD__;MultipleActiveResultSets=true;TrustServerCertificate=True"
//#endif
  },
//#endif
//#if (UseIdentity)
  "Identity": {
//#if (UsePasskeys)
    "Passkeys": {
      "ServerDomain": "example.com",
      "AllowedOrigins": [ "https://internal.example.com", "https://www.example.com" ]
    }
//#endif
  },
//#endif
//#if (UseApiKey)
  "Security": {
    "ApiKey": "__API_KEY__"
  },
//#endif
//#if (UseSentry)
  "Sentry": {
    "Dsn": "__ERROR_MONITORING_KEY__",
    "SendDefaultPii": false,
    "MinimumEventLevel": "Error",
    "TracesSampleRate": 0.2
  },
//#elseif (UseRaygun)
  "RaygunSettings": {
    "ApiKey": "__ERROR_MONITORING_KEY__"
  },
//#elseif (UseAppInsights)
  "ApplicationInsights": {
    "ConnectionString": "__ERROR_MONITORING_KEY__"
  },
//#endif
//#if (IncludeSerilog)
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/TemplateApp.API-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

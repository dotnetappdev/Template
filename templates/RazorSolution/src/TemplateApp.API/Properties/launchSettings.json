{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
//#if (UseSwaggerUi)
      "launchUrl": "swagger",
//#elseif (UseScalar)
      "launchUrl": "scalar",
//#else
      "launchUrl": "api/status",
//#endif
      "applicationUrl": "http://localhost:__HTTP_PORT_API__",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
//#if (UseSwaggerUi)
      "launchUrl": "swagger",
//#elseif (UseScalar)
      "launchUrl": "scalar",
//#else
      "launchUrl": "api/status",
//#endif
      "applicationUrl": "https://localhost:__HTTPS_PORT_API__;http://localhost:__HTTP_PORT_API__",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}

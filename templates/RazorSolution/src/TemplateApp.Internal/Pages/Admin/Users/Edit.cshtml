@page "{id}"
@model TemplateApp.Internal.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = Model.UserDetails?.Email ?? "User";
}

<a asp-page="Index" class="small"><i class="fas fa-arrow-left me-1 mr-1"></i>All users</a>
@if (Model.UserDetails is null)
{
    <div class="alert alert-warning mt-3">That user was not found.</div>
}
else
{
    var u = Model.UserDetails;
    <h1 class="h2 mt-2"><i class="fas fa-user me-2 mr-2"></i>@u.Email</h1>
    <div class="row mt-3">
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Name</dt><dd class="col-sm-7">@(u.DisplayName ?? "-")</dd>
                        <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@u.CreatedUtc.ToLocalTime().ToString("d MMM yyyy")</dd>
                        <dt class="col-sm-5">Two-factor</dt><dd class="col-sm-7">@(u.TwoFactorEnabled ? "On" : "Off")</dd>
@*#if (UsePasskeys)*@
                        <dt class="col-sm-5">Passkeys</dt><dd class="col-sm-7">@u.PasskeyCount</dd>
@*#endif*@
                        <dt class="col-sm-5">Failed sign-ins</dt><dd class="col-sm-7">@u.AccessFailedCount</dd>
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">@(u.LockedOut ? "Locked" : "Active")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Roles</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Roles" asp-route-id="@u.Id">
                        @foreach (var role in Model.AllRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="@role" id="role-@role" checked="@(u.Roles.Contains(role))" />
                                <label class="form-check-label" for="role-@role">@role</label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary btn-sm mt-3">Save roles</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">Security</div>
        <div class="card-body d-flex flex-wrap gap-2">
            @if (u.LockedOut)
            {
                <form method="post" asp-page-handler="Unlock" asp-route-id="@u.Id"><button class="btn btn-outline-success me-2 mr-2 mb-2"><i class="fas fa-lock-open me-1 mr-1"></i>Unlock</button></form>
            }
            else
            {
                <form method="post" asp-page-handler="Lock" asp-route-id="@u.Id" class="js-confirm" data-confirm="Lock @u.Email out?"><button class="btn btn-outline-warning me-2 mr-2 mb-2"><i class="fas fa-lock me-1 mr-1"></i>Lock out</button></form>
            }
            <form method="post" asp-page-handler="ResetTwoFactor" asp-route-id="@u.Id" class="js-confirm" data-confirm="Turn off two-factor for @u.Email? They will set up their authenticator again."><button class="btn btn-outline-secondary me-2 mr-2 mb-2"><i class="fas fa-mobile-alt me-1 mr-1"></i>Reset two-factor</button></form>
@*#if (UsePasskeys)*@
            <form method="post" asp-page-handler="RemovePasskeys" asp-route-id="@u.Id" class="js-confirm" data-confirm="Remove all passkeys of @u.Email?"><button class="btn btn-outline-secondary me-2 mr-2 mb-2"><i class="fas fa-fingerprint me-1 mr-1"></i>Remove passkeys</button></form>
@*#endif*@
            <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="js-confirm" data-confirm="Delete @u.Email? This cannot be undone."><button class="btn btn-outline-danger mb-2"><i class="fas fa-trash me-1 mr-1"></i>Delete user</button></form>
        </div>
    </div>
}

@page
@model TemplateApp.Internal.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center py-5">
    <h1 class="h3"><i class="fas fa-ban me-2 mr-2 text-danger"></i>Access denied</h1>
    <p class="text-muted">Your account (@User.Identity?.Name) does not have permission to open that page.</p>
    <form method="post" asp-page="/Account/Logout" class="d-inline">
        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-sign-out-alt me-1 mr-1"></i>Sign in with a different account</button>
    </form>
</div>

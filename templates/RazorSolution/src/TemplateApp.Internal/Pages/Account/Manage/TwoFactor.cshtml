@page
@model TemplateApp.Internal.Pages.Account.Manage.TwoFactorModel
@{
    ViewData["Title"] = "Two-factor authentication";
}
<h1 class="h2 mb-4"><i class="fas fa-user-circle me-2 mr-2"></i>My account</h1>
<div class="row">
    <div class="col-md-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-md-9">
        <h2 class="h4">Two-factor authentication</h2>
        @if (Model.Status is null)
        {
            <div class="alert alert-warning">The two-factor settings could not be loaded from the API.</div>
        }
        else if (Model.RecoveryCodes is { Length: > 0 })
        {
            <div class="alert alert-success"><i class="fas fa-check-circle me-2 mr-2"></i>Save these recovery codes somewhere safe. Each one signs you in once if you lose your device. They are shown only now.</div>
            <div class="row g-2 mb-3" id="recovery-codes">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <div class="col-6 col-md-4"><code class="d-block p-2 border rounded text-center">@code</code></div>
                }
            </div>
            <a asp-page="TwoFactor" class="btn btn-primary">Done</a>
        }
        else if (Model.Status.IsTwoFactorEnabled)
        {
            <p><span class="badge bg-success badge-success"><i class="fas fa-shield-alt me-1 mr-1"></i>On</span> Signing in asks for a code from your authenticator app.</p>
            <p class="text-muted">Recovery codes left: <strong>@Model.Status.RecoveryCodesLeft</strong></p>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" asp-page-handler="ResetRecoveryCodes" class="d-inline js-confirm" data-confirm="Replace your recovery codes? The old ones stop working.">
                    <button class="btn btn-outline-primary me-2 mr-2 mb-2">New recovery codes</button>
                </form>
                <form method="post" asp-page-handler="ResetKey" class="d-inline js-confirm" data-confirm="Reset the authenticator? Two-factor turns off until you set it up again.">
                    <button class="btn btn-outline-secondary me-2 mr-2 mb-2">Reset authenticator app</button>
                </form>
                <form method="post" asp-page-handler="Disable" class="d-inline js-confirm" data-confirm="Turn two-factor authentication off?">
                    <button class="btn btn-outline-danger mb-2">Turn off</button>
                </form>
            </div>
        }
        else
        {
            <p><span class="badge bg-secondary badge-secondary">Off</span> Add a second step to signing in with an authenticator app (Microsoft Authenticator, Google Authenticator, 1Password, …).</p>
            <ol class="ps-3 pl-3">
                <li class="mb-3">
                    Scan this QR code with the app, or type the key in by hand.
                    <div class="d-flex flex-wrap align-items-center mt-2">
                        <div id="authenticator-qr" class="border rounded p-2 bg-white me-3 mr-3" data-uri="@Model.AuthenticatorUri" aria-label="QR code for the authenticator app"></div>
                        <div>
                            <div class="small text-muted">Key</div>
                            <code class="fs-5 h5" id="shared-key">@Model.FormattedKey</code>
                        </div>
                    </div>
                </li>
                <li>
                    Enter the 6-digit code the app shows.
                    <form method="post" asp-page-handler="Enable" class="mt-2" style="max-width: 22rem">
                        <div class="input-group">
                            <input name="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" aria-label="Verification code" required />
                            <button type="submit" class="btn btn-primary">Turn on</button>
                        </div>
                    </form>
                </li>
            </ol>
        }
    </div>
</div>
@section Scripts {
    <script src="~/lib/qrcode-generator/qrcode.js"></script>
    <script>
        (function () {
            var el = document.getElementById('authenticator-qr');
            if (!el || !window.qrcode) { return; }
            var qr = qrcode(0, 'M');
            qr.addData(el.dataset.uri);
            qr.make();
            el.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 0 });
        })();
    </script>
}

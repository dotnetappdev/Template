@page
@model TemplateApp.Internal.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4 text-center">
        <h1 class="h3 mb-3">Sign out</h1>
        <form method="post">
            <button type="submit" class="btn btn-primary"><i class="fas fa-sign-out-alt me-1 mr-1"></i>Sign out</button>
        </form>
    </div>
</div>

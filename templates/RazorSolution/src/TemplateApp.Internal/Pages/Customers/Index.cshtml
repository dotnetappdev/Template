@page
@model TemplateApp.Internal.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0"><i class="fas fa-users me-2 mr-2"></i>Customers</h1>
    <a asp-page="Create" class="btn btn-primary"><i class="fas fa-plus me-1 mr-1"></i>New customer</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input asp-for="Search" class="form-control js-customer-autocomplete" placeholder="Search by name, email or company"
               data-source-url="@Url.Page("Index", "Autocomplete")" aria-label="Search" />
        <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i> Search</button>
    </div>
</form>

@if (Model.ApiError is not null)
{
    <div class="alert alert-warning"><i class="fas fa-plug me-2 mr-2"></i>@Model.ApiError</div>
}
else if (Model.Customers.Count == 0)
{
    <div class="alert alert-info"><i class="fas fa-info-circle me-2 mr-2"></i>No customers found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle js-datatable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th class="text-end text-right" data-orderable="false"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>@customer.FullName</td>
                        <td><a href="mailto:@customer.Email">@customer.Email</a></td>
                        <td>@customer.Company</td>
                        <td>
                            @if (customer.IsActive)
                            {
                                <span class="badge bg-success badge-success"><i class="fas fa-check me-1 mr-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary badge-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-right">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@customer.Id" class="d-inline js-confirm"
                                  data-confirm="Delete @customer.FullName?">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fas fa-trash"></i><span class="visually-hidden sr-only">Delete</span></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

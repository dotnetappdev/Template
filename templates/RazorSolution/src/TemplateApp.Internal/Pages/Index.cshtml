@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-5"><i class="fas fa-user-shield text-primary me-2 mr-2"></i>TemplateApp Internal</h1>
    <p class="lead">Internal staff / back-office site: an ASP.NET Core Razor Pages site (no Areas) that gets all of its data from TemplateApp.API.</p>
@*#if (UseSqlRepository)*@
    <a asp-page="/Customers/Index" class="btn btn-primary btn-lg"><i class="fas fa-users me-2 mr-2"></i>View customers</a>
@*#endif*@
</div>

<div class="mb-4">
    <partial name="_ApiStatus" model="Model.ApiStatus" />
</div>
<div class="card mb-4">
    <div class="card-header"><i class="fas fa-layer-group me-2 mr-2"></i>Front-end stack (LibMan)</div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between"><span>jQuery</span><span class="badge bg-secondary badge-secondary">__JQUERY_VERSION__</span></li>
        <li class="list-group-item d-flex justify-content-between"><span>jQuery UI <small class="text-muted">(__JQUERYUI_THEME__ theme)</small></span><span class="badge bg-secondary badge-secondary">__JQUERYUI_VERSION__</span></li>
        <li class="list-group-item d-flex justify-content-between"><span>Bootstrap <small class="text-muted">(__BOOTSWATCH_THEME__)</small></span><span class="badge bg-secondary badge-secondary">__BOOTSTRAP_VERSION__</span></li>
@*#if (UseFontAwesome)*@
        <li class="list-group-item d-flex justify-content-between"><span>Font Awesome Free</span><span class="badge bg-secondary badge-secondary">__FONTAWESOME_VERSION__</span></li>
@*#endif*@
@*#if (IncludeDataTables)*@
        <li class="list-group-item d-flex justify-content-between"><span>DataTables</span><span class="badge bg-secondary badge-secondary">2.3.8</span></li>
@*#endif*@
@*#if (IncludeSelect2)*@
        <li class="list-group-item d-flex justify-content-between"><span>Select2</span><span class="badge bg-secondary badge-secondary">4.1.0</span></li>
@*#endif*@
@*#if (IncludeToastr)*@
        <li class="list-group-item d-flex justify-content-between"><span>Toastr</span><span class="badge bg-secondary badge-secondary">2.1.4</span></li>
@*#endif*@
@*#if (IncludeSweetAlert)*@
        <li class="list-group-item d-flex justify-content-between"><span>SweetAlert2</span><span class="badge bg-secondary badge-secondary">11.26.25</span></li>
@*#endif*@
@*#if (IncludeChartJs)*@
        <li class="list-group-item d-flex justify-content-between"><span>Chart.js</span><span class="badge bg-secondary badge-secondary">4.5.1</span></li>
@*#endif*@
    </ul>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-layer-group text-primary me-2 mr-2"></i>Bootstrap</h5>
                <p class="card-text">Bootstrap __BOOTSTRAP_VERSION__ handles the layout, grid and components.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-calendar-alt text-primary me-2 mr-2"></i>jQuery UI</h5>
                <p class="card-text">jQuery __JQUERY_VERSION__ with jQuery UI __JQUERYUI_VERSION__. Try the date picker and dialog:</p>
                <input type="text" class="form-control js-datepicker mb-2" placeholder="Pick a date" aria-label="Pick a date" />
                <button type="button" class="btn btn-outline-primary btn-sm js-open-dialog" data-dialog="#about-dialog">
                    <i class="fas fa-info-circle me-1 mr-1"></i>Open dialog
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fab fa-font-awesome text-primary me-2 mr-2"></i>Font Awesome</h5>
                <p class="card-text">Font Awesome Free __FONTAWESOME_VERSION__ icons:</p>
                <p class="h3 mb-0">
                    <i class="fas fa-home"></i> <i class="fas fa-users"></i> <i class="fas fa-database"></i>
                    <i class="fas fa-lock"></i> <i class="fab fa-github"></i>
                </p>
            </div>
        </div>
    </div>
</div>

<div id="about-dialog" title="TemplateApp Internal" class="d-none">
    <p>This dialog is a jQuery UI widget. Its behaviour is set up in <code>wwwroot/js/site.js</code>.</p>
</div>

@*#if (IncludeChartJs)*@

<div class="card mb-4">
    <div class="card-header"><i class="fas fa-chart-bar me-2 mr-2"></i>Requests this week (sample data)</div>
    <div class="card-body"><canvas id="weekly-chart" height="90"></canvas></div>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('weekly-chart'), {
            type: 'bar',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{ label: 'Requests', data: [12, 19, 8, 15, 22, 5, 3], borderWidth: 1 }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });
    </script>
}
@*#endif*@

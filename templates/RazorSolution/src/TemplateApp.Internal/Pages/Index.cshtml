@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-5"><i class="fas fa-user-shield text-primary me-2 mr-2"></i>TemplateApp Internal</h1>
    <p class="lead">Internal staff / back-office site: an ASP.NET Core Razor Pages site (no Areas) that gets all of its data from TemplateApp.API.</p>
@*#if (UseSqlRepository)*@
    <a asp-page="/Customers/Index" class="btn btn-primary btn-lg"><i class="fas fa-users me-2 mr-2"></i>View customers</a>
@*#endif*@
</div>

<div class="mb-4">
    <partial name="_ApiStatus" model="Model.ApiStatus" />
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-layer-group text-primary me-2 mr-2"></i>Bootstrap</h5>
                <p class="card-text">Bootstrap __BOOTSTRAP_VERSION__ handles the layout, grid and components.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-calendar-alt text-primary me-2 mr-2"></i>jQuery UI</h5>
                <p class="card-text">jQuery __JQUERY_VERSION__ with jQuery UI __JQUERYUI_VERSION__. Try the date picker and dialog:</p>
                <input type="text" class="form-control js-datepicker mb-2" placeholder="Pick a date" aria-label="Pick a date" />
                <button type="button" class="btn btn-outline-primary btn-sm js-open-dialog" data-dialog="#about-dialog">
                    <i class="fas fa-info-circle me-1 mr-1"></i>Open dialog
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="fab fa-font-awesome text-primary me-2 mr-2"></i>Font Awesome</h5>
                <p class="card-text">Font Awesome Free __FONTAWESOME_VERSION__ icons:</p>
                <p class="h3 mb-0">
                    <i class="fas fa-home"></i> <i class="fas fa-users"></i> <i class="fas fa-database"></i>
                    <i class="fas fa-lock"></i> <i class="fab fa-github"></i>
                </p>
            </div>
        </div>
    </div>
</div>

<div id="about-dialog" title="TemplateApp Internal" class="d-none">
    <p>This dialog is a jQuery UI widget. Its behaviour is set up in <code>wwwroot/js/site.js</code>.</p>
</div>

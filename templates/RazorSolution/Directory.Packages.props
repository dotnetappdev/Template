<Project>
  <!--
    Central Package Management: every NuGet version used by the solution lives here.
    Upgrade a package by changing its version once, in this file.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
<!--#if (UseSqlRepository) -->
    <!-- Entity Framework Core (matches the target framework) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="__EFCORE_VERSION__" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="__EFCORE_VERSION__" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="__EFCORE_VERSION__" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="__EFCORE_VERSION__" />
<!--#if (UseSqlServer) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="__EFCORE_VERSION__" />
<!--#if (PinSqlClient) -->
    <!-- Newer than EF Core's minimum: brings a patched System.Security.Cryptography.Pkcs (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" />
<!--#endif -->
<!--#elseif (UsePostgreSql) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="__NPGSQL_VERSION__" />
<!--#elseif (UseSqlite) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="__EFCORE_VERSION__" />
<!--#endif -->
<!--#if (IncludeHealthChecks) -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="__EFCORE_VERSION__" />
<!--#endif -->
<!--#if (UseIdentity) -->
    <!-- ASP.NET Core Identity (users, roles, two-factor, passkeys) stored by EF Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="__EFCORE_VERSION__" />
<!--#endif -->
<!--#endif -->
<!--#if (UseApi && UseSwagger) -->

    <!-- API documentation -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="__SWASHBUCKLE_VERSION__" />
<!--#endif -->
<!--#if (IncludeSerilog) -->

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="__SERILOG_VERSION__" />
<!--#endif -->
<!--#if (UseSentry) -->

    <!-- Error monitoring: Sentry (sentry.io) -->
    <PackageVersion Include="Sentry.AspNetCore" Version="6.12.1" />
<!--#elseif (UseRaygun) -->

    <!-- Error monitoring: Raygun (raygun.com) -->
    <PackageVersion Include="Mindscape.Raygun4Net.AspNetCore" Version="11.2.7" />
<!--#elseif (UseAppInsights) -->

    <!-- Error monitoring: Azure Application Insights -->
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
<!--#endif -->
<!--#if (UseWindowsAuth) -->

    <!-- Internal site: Windows authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="__EFCORE_VERSION__" />
<!--#endif -->
<!--#if (UseEntraId) -->

    <!-- Internal site: Microsoft Entra ID sign-in -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.16.0" />
<!--#endif -->
<!--#if (HasSite) -->

    <!-- Sites: LibMan restore on build -->
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
<!--#if (IncludeResilience) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="__RESILIENCE_VERSION__" />
<!--#endif -->
<!--#endif -->
<!--#if (UseTests) -->

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
<!--#endif -->
  </ItemGroup>
</Project>

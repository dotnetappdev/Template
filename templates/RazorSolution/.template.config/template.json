{
  "$schema": "http://json.schemastore.org/template",
  "author": "dotnetappdev",
  "classifications": [
    "Web",
    "Razor Pages",
    "Web API",
    "EF Core",
    "LibMan"
  ],
  "name": "Razor Pages Solution (Internal, External, API, Services, SqlRepository)",
  "description": "Two independent Razor Pages sites (Internal and External, no Areas) that only talk to ProjectName.API, on top of a Services layer and an EF Core SqlRepository (repository pattern). Pick the .NET version (LTS/STS), SQL Server / PostgreSQL / SQLite and version, connection string, authentication, and jQuery, jQuery UI (+theme), Bootstrap (+Bootswatch theme), Font Awesome Free, DataTables, Select2, Toastr, SweetAlert2 and Chart.js via LibMan, and Sentry / Raygun / Application Insights error monitoring.",
  "identity": "DotNetAppDev.RazorSolution.CSharp",
  "groupIdentity": "DotNetAppDev.RazorSolution",
  "shortName": "razorsln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "TemplateApp",
  "preferNameDirectory": true,
  "defaultName": "MyCompany.Portal",
  "guids": [
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F61",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F62",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F63",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F64",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F65",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F66",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F67",
    "7A0D5E21-0C3B-4F55-8D2E-6B1F9C4A2E02",
    "7A0D5E21-0C3B-4F55-8D2E-6B1F9C4A2E03",
    "7A0D5E21-0C3B-4F55-8D2E-6B1F9C4A2E04",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F68",
    "3F1C2A10-5B6D-4E8F-9A01-1B2C3D4E5F69"
  ],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/*.user",
        "**/*.db",
        "**/wwwroot/lib/**"
      ],
      "copyOnly": [
        "**/*.png",
        "**/*.ico",
        "**/*.woff2"
      ],
      "modifiers": [
        {
          "condition": "(HostIdentifier == \"vs\")",
          "exclude": [
            "TemplateApp.sln"
          ]
        },
        {
          "condition": "(!UseApi)",
          "exclude": [
            "src/TemplateApp.API/**"
          ]
        },
        {
          "condition": "(!IncludeInternal)",
          "exclude": [
            "src/TemplateApp.Internal/**"
          ]
        },
        {
          "condition": "(!IncludeExternal)",
          "exclude": [
            "src/TemplateApp.External/**"
          ]
        },
        {
          "condition": "(!HasSite)",
          "exclude": [
            "Directory.Build.targets"
          ]
        },
        {
          "condition": "(!UseServices)",
          "exclude": [
            "src/TemplateApp.Services/**"
          ]
        },
        {
          "condition": "(!UseSqlRepository)",
          "exclude": [
            "src/TemplateApp.SqlRepository/**",
            "src/TemplateApp.Internal/Pages/Customers/**",
            "src/TemplateApp.Internal/ApiClients/ICustomerApiClient.cs",
            "src/TemplateApp.Internal/ApiClients/CustomerApiClient.cs",
            "src/TemplateApp.Internal/ApiClients/Models/CustomerModels.cs",
            "src/TemplateApp.API/Controllers/CustomersController.cs"
          ]
        },
        {
          "condition": "(!UseTests)",
          "exclude": [
            "tests/**"
          ]
        },
        {
          "condition": "(!UseApiKey)",
          "exclude": [
            "src/TemplateApp.API/Security/**",
            "src/TemplateApp.Internal/ApiClients/ApiKeyHandler.cs",
            "src/TemplateApp.External/ApiClients/ApiKeyHandler.cs"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The .NET version (target framework) for every project.",
      "displayName": "Framework",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0",
          "displayName": ".NET 8.0 (Long Term Support)",
          "description": ".NET 8.0 (LTS)"
        },
        {
          "choice": "net9.0",
          "displayName": ".NET 9.0 (Standard Term Support)",
          "description": ".NET 9.0 (STS)"
        },
        {
          "choice": "net10.0",
          "displayName": ".NET 10.0 (Long Term Support)",
          "description": ".NET 10.0 (LTS)"
        },
        {
          "choice": "net11.0",
          "displayName": ".NET 11.0 (Standard Term Support - Preview)",
          "description": ".NET 11.0 (STS, preview packages)"
        }
      ],
      "replaces": "net8.0",
      "defaultValue": "net8.0"
    },
    "IncludeApi": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.API",
      "description": "Adds the ASP.NET Core Web API project (controllers + Swagger). The Internal and External sites only talk to this API, so it is always created when either site is selected."
    },
    "IncludeInternal": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.Internal",
      "description": "Adds the Internal (staff / back-office) Razor Pages site. It calls ProjectName.API over HTTP and has no database access."
    },
    "IncludeExternal": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.External",
      "description": "Adds the External (public / customer facing) Razor Pages site. It calls ProjectName.API over HTTP and has no database access."
    },
    "IncludeServices": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.Services",
      "description": "Adds the business services layer used by the API (service interfaces + implementations). Also adds ProjectName.SqlRepository."
    },
    "IncludeSqlRepository": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.SqlRepository",
      "description": "Adds the EF Core data project used by the API: ApplicationDbContext, entities, IRepository<T> and the repositories."
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Create ProjectName.Tests (xUnit + NSubstitute)",
      "description": "Adds an xUnit test project with NSubstitute mocks for ProjectName.Services (needs Services)."
    },
    "UseServices": {
      "type": "computed",
      "datatype": "bool",
      "value": "(IncludeServices)"
    },
    "UseSqlRepository": {
      "type": "computed",
      "datatype": "bool",
      "value": "(IncludeSqlRepository || IncludeServices)"
    },
    "UseApi": {
      "type": "computed",
      "datatype": "bool",
      "value": "(IncludeApi || IncludeInternal || IncludeExternal)"
    },
    "HasSite": {
      "type": "computed",
      "datatype": "bool",
      "value": "(IncludeInternal || IncludeExternal)"
    },
    "DatabaseProvider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "SqlServer",
      "displayName": "Database",
      "description": "The EF Core database provider used by ProjectName.SqlRepository.",
      "choices": [
        {
          "choice": "SqlServer",
          "displayName": "SQL Server / Azure SQL",
          "description": "Microsoft SQL Server or Azure SQL Database"
        },
        {
          "choice": "PostgreSQL",
          "displayName": "PostgreSQL",
          "description": "PostgreSQL via Npgsql"
        },
        {
          "choice": "Sqlite",
          "displayName": "SQLite",
          "description": "SQLite file database"
        }
      ]
    },
    "SqlServerVersion": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "SqlServer2022",
      "displayName": "SQL Server version",
      "description": "The SQL Server version to target. EF Core uses its compatibility level to decide which SQL it generates. Used only when the database is SQL Server.",
      "choices": [
        {
          "choice": "SqlServer2014",
          "displayName": "SQL Server 2014 (compat 120)",
          "description": "SQL Server 2014"
        },
        {
          "choice": "SqlServer2016",
          "displayName": "SQL Server 2016 (compat 130)",
          "description": "SQL Server 2016"
        },
        {
          "choice": "SqlServer2017",
          "displayName": "SQL Server 2017 (compat 140)",
          "description": "SQL Server 2017"
        },
        {
          "choice": "SqlServer2019",
          "displayName": "SQL Server 2019 (compat 150)",
          "description": "SQL Server 2019"
        },
        {
          "choice": "SqlServer2022",
          "displayName": "SQL Server 2022 (compat 160)",
          "description": "SQL Server 2022"
        },
        {
          "choice": "SqlServer2025",
          "displayName": "SQL Server 2025 (compat 170)",
          "description": "SQL Server 2025"
        },
        {
          "choice": "AzureSql",
          "displayName": "Azure SQL Database",
          "description": "Azure SQL Database (adds retry on failure)"
        }
      ]
    },
    "PostgresVersion": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "17",
      "displayName": "PostgreSQL version",
      "description": "The PostgreSQL server version to target. Used only when the database is PostgreSQL.",
      "replaces": "__POSTGRES_MAJOR__",
      "choices": [
        {
          "choice": "14",
          "displayName": "PostgreSQL 14",
          "description": "PostgreSQL 14"
        },
        {
          "choice": "15",
          "displayName": "PostgreSQL 15",
          "description": "PostgreSQL 15"
        },
        {
          "choice": "16",
          "displayName": "PostgreSQL 16",
          "description": "PostgreSQL 16"
        },
        {
          "choice": "17",
          "displayName": "PostgreSQL 17",
          "description": "PostgreSQL 17"
        },
        {
          "choice": "18",
          "displayName": "PostgreSQL 18",
          "description": "PostgreSQL 18"
        }
      ]
    },
    "DbAuthentication": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Integrated",
      "displayName": "Database authentication",
      "description": "How the connection string signs in. PostgreSQL always uses a user name and password.",
      "choices": [
        {
          "choice": "Integrated",
          "displayName": "Windows / Integrated (Entra ID for Azure SQL)",
          "description": "Trusted_Connection (SQL Server) or Active Directory Default (Azure SQL)"
        },
        {
          "choice": "SqlLogin",
          "displayName": "SQL login (user name + password)",
          "description": "User Id / Password in the connection string"
        }
      ]
    },
    "DbServer": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Database server",
      "description": "Server/host for the connection string. Leave blank for the default: (localdb)\\MSSQLLocalDB, your-server.database.windows.net or localhost."
    },
    "DbName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Database name",
      "description": "Database name. Leave blank to use the project name."
    },
    "DbUser": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Database user",
      "description": "User name for a SQL login or PostgreSQL. Leave blank for sa / postgres."
    },
    "DbPassword": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Database password",
      "description": "Password for a SQL login or PostgreSQL (development only; use user-secrets or Key Vault for real secrets)."
    },
    "ConnectionString": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Connection string (overrides the fields above)",
      "description": "A full connection string. If you enter one, the server, database, user and password fields are ignored."
    },
    "SeedSampleData": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Seed sample data (customers)",
      "description": "Seeds a few sample customers when the API starts in Development."
    },
    "IncludeSwagger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Add Swagger UI to the API (Swashbuckle.AspNetCore)",
      "description": "Adds Swagger / OpenAPI documentation at /swagger in Development."
    },
    "IncludeApiKey": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Secure the API with an API key (X-Api-Key)",
      "description": "The API requires an X-Api-Key header; Internal and External send it automatically (key generated per solution)."
    },
    "IncludeHealthChecks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Add health check endpoints /health (Microsoft.Extensions.Diagnostics.HealthChecks)",
      "description": "Adds /health to every project; the API also checks the database (HealthChecks.EntityFrameworkCore)."
    },
    "IncludeSerilog": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add Serilog logging (Serilog.AspNetCore)",
      "description": "Structured logging to the console and rolling files, configured in appsettings.json."
    },
    "ErrorMonitoring": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "None",
      "displayName": "Error monitoring",
      "description": "Send unhandled exceptions (API and sites, plus browser JavaScript errors for Sentry and Raygun) to an error-monitoring service.",
      "choices": [
        {
          "choice": "None",
          "displayName": "None",
          "description": "Errors are only logged"
        },
        {
          "choice": "Sentry",
          "displayName": "Sentry (sentry.io)",
          "description": "Sentry.AspNetCore + Sentry browser SDK"
        },
        {
          "choice": "Raygun",
          "displayName": "Raygun (raygun.com)",
          "description": "Mindscape.Raygun4Net.AspNetCore + raygun4js"
        },
        {
          "choice": "ApplicationInsights",
          "displayName": "Azure Application Insights",
          "description": "Microsoft.ApplicationInsights.AspNetCore"
        }
      ]
    },
    "ErrorMonitoringKey": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Error monitoring key (optional)",
      "description": "Sentry DSN, Raygun API key or Application Insights connection string. Leave blank to set it later in appsettings.json or user-secrets."
    },
    "IncludeResilience": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Add retries / circuit breaker to API clients (Microsoft.Extensions.Http.Resilience)",
      "description": "Adds the standard resilience handler (Polly) to the sites' typed HttpClients."
    },
    "InternalAuthentication": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "None",
      "displayName": "Internal site authentication",
      "description": "How staff sign in to ProjectName.Internal.",
      "choices": [
        {
          "choice": "None",
          "displayName": "None",
          "description": "None"
        },
        {
          "choice": "Windows",
          "displayName": "Windows authentication (Negotiate / Kerberos)",
          "description": "Windows authentication (Negotiate / Kerberos)"
        },
        {
          "choice": "EntraId",
          "displayName": "Microsoft Entra ID (Microsoft.Identity.Web)",
          "description": "Microsoft Entra ID (Microsoft.Identity.Web)"
        }
      ]
    },
    "EntraTenantId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Entra ID tenant ID (optional)",
      "description": "Directory (tenant) ID for Microsoft Entra ID sign-in. Can be set later in appsettings.json."
    },
    "EntraClientId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Entra ID client ID (optional)",
      "description": "Application (client) ID of the app registration for the Internal site. Can be set later in appsettings.json."
    },

{
  "$comment": "Pages of the Visual Studio wizard. Fields are template.json symbol ids; labels, choices and defaults come from the template. 'when' = any of the listed condition sets must match (all keys in a set must match one of the values).",
  "steps": [
    {
      "id": "projects",
      "title": "Projects",
      "subtitle": "Pick the .NET version and the projects to create. The sites only talk to the API, so the API is created whenever a site is selected.",
      "fields": [
        "Framework",
        "IncludeInternal",
        "IncludeExternal",
        "IncludeApi",
        "IncludeServices",
        "IncludeSqlRepository",
        "IncludeTests"
      ]
    },
    {
      "id": "database",
      "title": "Database",
      "subtitle": "Choose the database the API uses and test the connection before you create the solution.",
      "when": [
        {
          "IncludeSqlRepository": [
            "true"
          ]
        },
        {
          "IncludeServices": [
            "true"
          ]
        },
        {
          "IncludeInternal": [
            "true"
          ],
          "InternalAuthentication": [
            "Identity"
          ]
        },
        {
          "IncludeExternal": [
            "true"
          ],
          "ExternalAuthentication": [
            "Identity"
          ]
        }
      ],
      "fields": [
        "DatabaseProvider",
        "SqlServerVersion",
        "PostgresVersion",
        "DbAuthentication",
        "DbServer",
        "DbName",
        "DbUser",
        "DbPassword",
        "ConnectionString",
        "SeedSampleData"
      ],
      "testConnection": true
    },
    {
      "id": "api",
      "title": "API, security & sign-in",
      "subtitle": "Options for ProjectName.API, error monitoring, and how staff and customers sign in to the sites.",
      "fields": [
        "ApiDocumentation",
        "IncludeApiKey",
        "IncludeHealthChecks",
        "IncludeSerilog",
        "ErrorMonitoring",
        "ErrorMonitoringKey",
        "InternalAuthentication",
        "EntraTenantId",
        "EntraClientId",
        "ExternalAuthentication",
        "IdentitySignIn",
        "IdentityTwoFactor",
        "IdentityPasskeys",
        "IdentityAdminUi",
        "IncludeResilience"
      ]
    },
    {
      "id": "frontend",
      "title": "Front end",
      "subtitle": "Client-side libraries for the Internal and External sites. LibMan restores them into wwwroot/lib on build.",
      "when": [
        {
          "IncludeInternal": [
            "true"
          ]
        },
        {
          "IncludeExternal": [
            "true"
          ]
        }
      ],
      "fields": [
        "JQueryVersion",
        "JQueryUIVersion",
        "JQueryUITheme",
        "BootstrapVersion",
        "BootstrapTheme",
        "FontAwesomeVersion",
        "IncludeColorModes",
        "IncludeJQueryValidation",
        "IncludeDataTables",
        "IncludeSelect2",
        "IncludeToastr",
        "IncludeSweetAlert",
        "IncludeChartJs"
      ]
    },
    {
      "id": "summary",
      "title": "Summary",
      "subtitle": "Check your choices. Create runs the dotnet new command below and opens the solution.",
      "fields": []
    }
  ],
  "fieldRules": {
    "IncludeTests": [
      {
        "IncludeServices": [
          "true"
        ]
      }
    ],
    "SqlServerVersion": [
      {
        "DatabaseProvider": [
          "SqlServer"
        ]
      }
    ],
    "PostgresVersion": [
      {
        "DatabaseProvider": [
          "PostgreSQL"
        ]
      }
    ],
    "DbAuthentication": [
      {
        "DatabaseProvider": [
          "SqlServer"
        ]
      }
    ],
    "DbServer": [
      {
        "DatabaseProvider": [
          "SqlServer",
          "PostgreSQL"
        ]
      }
    ],
    "DbUser": [
      {
        "DatabaseProvider": [
          "PostgreSQL"
        ]
      },
      {
        "DatabaseProvider": [
          "SqlServer"
        ],
        "DbAuthentication": [
          "SqlLogin"
        ]
      }
    ],
    "DbPassword": [
      {
        "DatabaseProvider": [
          "PostgreSQL"
        ]
      },
      {
        "DatabaseProvider": [
          "SqlServer"
        ],
        "DbAuthentication": [
          "SqlLogin"
        ]
      }
    ],
    "IncludeApiKey": [
      {
        "IncludeApi": [
          "true"
        ]
      },
      {
        "IncludeInternal": [
          "true"
        ]
      },
      {
        "IncludeExternal": [
          "true"
        ]
      }
    ],
    "InternalAuthentication": [
      {
        "IncludeInternal": [
          "true"
        ]
      }
    ],
    "EntraTenantId": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "EntraId"
        ]
      }
    ],
    "EntraClientId": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "EntraId"
        ]
      }
    ],
    "IncludeResilience": [
      {
        "IncludeInternal": [
          "true"
        ]
      },
      {
        "IncludeExternal": [
          "true"
        ]
      }
    ],
    "ErrorMonitoringKey": [
      {
        "ErrorMonitoring": [
          "Sentry",
          "Raygun",
          "ApplicationInsights"
        ]
      }
    ],
    "ExternalAuthentication": [
      {
        "IncludeExternal": [
          "true"
        ]
      }
    ],
    "IdentityTwoFactor": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "Identity"
        ]
      },
      {
        "IncludeExternal": [
          "true"
        ],
        "ExternalAuthentication": [
          "Identity"
        ]
      }
    ],
    "IdentityPasskeys": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "Identity"
        ],
        "Framework": [
          "net10.0",
          "net11.0"
        ]
      },
      {
        "IncludeExternal": [
          "true"
        ],
        "ExternalAuthentication": [
          "Identity"
        ],
        "Framework": [
          "net10.0",
          "net11.0"
        ]
      }
    ],
    "IdentityAdminUi": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "Identity"
        ]
      }
    ],
    "ApiDocumentation": [
      {
        "IncludeApi": [
          "true"
        ]
      },
      {
        "IncludeInternal": [
          "true"
        ]
      },
      {
        "IncludeExternal": [
          "true"
        ]
      }
    ],
    "IdentitySignIn": [
      {
        "IncludeInternal": [
          "true"
        ],
        "InternalAuthentication": [
          "Identity"
        ],
        "IncludeExternal": [
          "true"
        ],
        "ExternalAuthentication": [
          "Identity"
        ]
      }
    ],
    "IncludeColorModes": [
      {
        "BootstrapVersion": [
          "5.3.8",
          "5.3.7",
          "5.3.3"
        ]
      }
    ]
  },
  "passwordFields": [
    "DbPassword"
  ],
  "tiles": {
    "$comment": "Big-tile presentation for the wizard (WPF) and the web configurator. 'fields': per-field layout (large = icon + text, compact = small version tiles, swatch = color theme tiles). 'choices': per field and choice extras (badge, note, icon, swatch colors). 'icons': per bool field.",
    "fields": {
      "Framework": "large",
      "DatabaseProvider": "large",
      "SqlServerVersion": "compact",
      "PostgresVersion": "compact",
      "DbAuthentication": "large",
      "InternalAuthentication": "large",
      "JQueryVersion": "compact",
      "JQueryUIVersion": "compact",
      "JQueryUITheme": "swatch",
      "BootstrapVersion": "compact",
      "BootstrapTheme": "swatch",
      "FontAwesomeVersion": "compact",
      "ErrorMonitoring": "large",
      "ExternalAuthentication": "large",
      "ApiDocumentation": "large",
      "IdentitySignIn": "large"
    },
    "choices": {
      "Framework": {
        "net8.0": {
          "badge": "LTS",
          "note": "Long Term Support · support ends 10 Nov 2026",
          "icon": {
            "fa": "fa-solid fa-cube",
            "glyph": "E7B8",
            "color": "#512BD4"
          }
        },

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Out-of-process "Test connection" helper for the Visual Studio wizard.
    The wizard runs it with "dotnet RazorSolution.ConnectionTester.dll", so no database driver is ever
    loaded into the Visual Studio process. Usage (connection string on stdin):
      dotnet RazorSolution.ConnectionTester.dll (double-dash)provider SqlServer|PostgreSQL|Sqlite (double-dash)timeout 10
    Prints one line of JSON (success, message, detail); exit code 0 = connected. See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

</Project>

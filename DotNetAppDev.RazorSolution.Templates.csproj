<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs templates/** into a NuGet template package:
      dotnet pack -c Release -o artifacts
      dotnet new install artifacts/DotNetAppDev.RazorSolution.Templates.<version>.nupkg
    After it is installed, Visual Studio 2022 (17.3+) lists the template in File > New > Project.
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>DotNetAppDev.RazorSolution.Templates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Razor Pages Solution Template</Title>
    <Authors>dotnetappdev</Authors>
    <Description>Razor Pages solution template: two independent sites (ProjectName.Internal, ProjectName.External, no Areas) that only talk to ProjectName.API, which sits on ProjectName.Services and ProjectName.SqlRepository (EF Core + repository pattern). You can pick the .NET (LTS/STS), database and version, connection string, and the jQuery, jQuery UI, Bootstrap and Font Awesome versions (LibMan).</Description>
    <PackageTags>dotnet-new;templates;razor-pages;aspnetcore;webapi;efcore;repository-pattern;libman;jquery;bootstrap;fontawesome</PackageTags>
    <PackageProjectUrl>https://github.com/dotnetappdev/Template</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\wwwroot\lib\**;templates\**\*.user;templates\**\*.db" />
    <Compile Remove="**\*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
